#!/bin/sh
# Drives an isolated Amp Linux Desktop instance for verification. See ../SKILL.md.
#   verify-amp launch RUN [--signed-out] [--size WxH] [--scale S] [--set KEY=VALUE]...
#   verify-amp doctor RUN
#   verify-amp app RUN [ARGS...]      # start amp_native detached inside the session (e.g. --action new-thread;
#                                     # no ARGS after ctrl+q restarts the app)
#   verify-amp shot RUN NAME          # screenshot into the evidence dir
#   verify-amp logs RUN               # print the instance's log paths
#   verify-amp cleanup RUN
set -eu

repo=$(cd "$(dirname "$0")/../../../.." && pwd)
cmd=${1:?usage: verify-amp launch|doctor|app|shot|logs|cleanup RUN}
run=${2:?RUN name required}
shift 2
session="ampv-$run"
scratch="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/verify-amp/$run"
evidence="$repo/.amp/in/artifacts/verify/$run"

app_env() {
	echo "XDG_DATA_HOME=$scratch/data XDG_CONFIG_HOME=$scratch/config XDG_CACHE_HOME=$scratch/cache AMP_NATIVE_DEBUG=1"
}

case $cmd in
launch)
	signed_in=1 size=1600x1000 scale=1 sets=
	while [ $# -gt 0 ]; do
		case $1 in
		--signed-out) signed_in=0 ;;
		--set) sets="$sets $2"; shift ;;
		--size) size=$2; shift ;;
		--scale) scale=$2; shift ;;
		*) echo "verify-amp: unknown option $1" >&2; exit 2 ;;
		esac
		shift
	done
	if agent-desktop info "$session" >/dev/null 2>&1; then echo "verify-amp: $session already running; cleanup first" >&2; exit 1; fi
	mkdir -p "$scratch/data/amp-native" "$scratch/config/amp-native" "$scratch/cache/amp-native" "$evidence"
	chmod 700 "$scratch"
	if [ "$signed_in" = 1 ]; then
		# A copy of the owner's login and settings; the original is never written.
		[ -f "$HOME/.local/share/amp-native/web/cookies.sqlite" ] || { echo "verify-amp: no signed-in profile to copy; use --signed-out" >&2; exit 1; }
		cp -r "$HOME/.local/share/amp-native/web" "$scratch/data/amp-native/"
		[ -f "$HOME/.config/amp-native/settings.json" ] && cp "$HOME/.config/amp-native/settings.json" "$scratch/config/amp-native/"
	fi
	# --set KEY=VALUE changes the run's copy of settings.json (JSON values, else strings).
	[ -z "$sets" ] || python3 - "$scratch/config/amp-native/settings.json" $sets <<'PY'
import json, os, sys
path = sys.argv[1]
data = json.load(open(path)) if os.path.exists(path) else {}
for pair in sys.argv[2:]:
    key, _, value = pair.partition("=")
    try:
        data[key] = json.loads(value)
    except ValueError:
        data[key] = value
json.dump(data, open(path, "w"), indent=2)
PY
	[ -d "$HOME/.local/share/amp-native/icons" ] && cp -r "$HOME/.local/share/amp-native/icons" "$scratch/data/amp-native/"
	# Huddles import livekit from the data dir; link the installed copy instead of copying 90 MB.
	[ -d "$HOME/.local/share/amp-native/python" ] && ln -s "$HOME/.local/share/amp-native/python" "$scratch/data/amp-native/python"
	agent-desktop start "$session" --gpu --size "$size" >/dev/null
	[ "$scale" = 1 ] || agent-desktop swaymsg "$session" "output * scale $scale" >/dev/null
	# shellcheck disable=SC2046
	agent-desktop run "$session" --log "$scratch/cache/amp-native/stderr.log" -- env $(app_env) sh -c "cd '$repo' && exec python3 -m amp_native" >/dev/null 2>&1
	agent-desktop wait "$session" dev.ampnative.Amp 30 >/dev/null
	sleep 10
	agent-desktop windows "$session"
	echo "evidence: $evidence"
	;;
doctor)
	agent-desktop info "$session" >/dev/null 2>&1 || { echo "DOWN: no session $session"; exit 1; }
	pid=$(agent-desktop windows "$session" --json | python3 -c 'import json,sys; w=[x for x in json.load(sys.stdin) if x["app_id"]=="dev.ampnative.Amp"]; print(w[0]["pid"] if w else "")')
	[ -n "$pid" ] || { echo "DOWN: no Amp window in $session"; exit 1; }
	tr '\0' '\n' <"/proc/$pid/environ" | grep -q "^XDG_DATA_HOME=$scratch/data$" || { echo "FOREIGN: pid $pid does not use $scratch"; exit 1; }
	echo "pid $pid cwd $(readlink "/proc/$pid/cwd") commit $(git -C "$repo" rev-parse --short HEAD)$([ -z "$(git -C "$repo" status --porcelain)" ] || echo '+dirty')"
	# /proc shows the launch environment; the app sets GSK_RENDERER=gl itself when it is unset there.
	echo "renderer: $(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^GSK_RENDERER=//p' | grep . || echo 'gl (app default)')"
	log="$scratch/cache/amp-native/amp-native.log"
	echo "page: $(grep -o 'ampNavigationState [^ ]*' "$log" 2>/dev/null | tail -1 | cut -d' ' -f2)"
	if grep -q 'sign-in\|/__native/start' "$log" 2>/dev/null && ! grep -q '__native/home\|/threads/' "$log"; then echo "auth: signed out"; else echo "auth: signed in (page left the start screen)"; fi
	errors=$(grep -c -E 'WARNING|ERROR|Traceback' "$log" 2>/dev/null || true)
	echo "log warnings/errors: ${errors:-0} ($log)"
	tracebacks=$(cat "$scratch/cache/amp-native/"stderr*.log 2>/dev/null | grep -c Traceback || true)
	echo "stderr tracebacks: ${tracebacks:-0}"
	;;
app)
	# Detached and tracked by the session: a cold start becomes the long-running app instance,
	# which would block a foreground exec. A second instance hands its args to the running one and exits.
	# shellcheck disable=SC2046
	agent-desktop run "$session" --log "$scratch/cache/amp-native/stderr-app-$(date +%H%M%S).log" -- env $(app_env) sh -c "cd '$repo' && exec python3 -m amp_native $*" >/dev/null 2>&1
	echo "started amp_native $* in $session"
	;;
shot)
	name=${1:?NAME required}
	mkdir -p "$evidence"
	agent-desktop shot "$session" "$evidence/$name.png" >/dev/null
	echo "$evidence/$name.png"
	;;
logs)
	# Python log, then stderr (GTK/WebKit and tracebacks) of the launch and of each `app` run.
	echo "$scratch/cache/amp-native/amp-native.log"
	ls -t "$scratch/cache/amp-native/"stderr*.log 2>/dev/null
	;;
cleanup)
	mkdir -p "$evidence"
	cp "$scratch/cache/amp-native/amp-native.log" "$scratch/cache/amp-native/"stderr*.log "$evidence/" 2>/dev/null || true
	agent-desktop stop "$session" >/dev/null 2>&1 || true
	rm -rf "$scratch"
	echo "stopped $session, removed $scratch; evidence kept in $evidence"
	;;
*) echo "verify-amp: unknown command $cmd" >&2; exit 2 ;;
esac

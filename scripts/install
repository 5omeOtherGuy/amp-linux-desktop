#!/bin/sh
# Builds Amp for Linux from this checkout and installs it for the current user: the binary, the
# desktop entry that also receives the com.ampcode.amp.linux.auth sign-in callback, and the app
# icons.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
data=${XDG_DATA_HOME:-$HOME/.local/share}
bin=$HOME/.local/bin

command -v cargo >/dev/null && command -v clang++ >/dev/null && pkg-config --exists gtk4 libadwaita-1 webkitgtk-6.0 || {
	echo "install: needs cargo, clang, and GTK 4, libadwaita and WebKitGTK 6.0 with their headers:" >&2
	echo "  Arch:   pacman -S rust clang gtk4 libadwaita webkitgtk-6.0 gst-plugins-base-libs gst-libav 7zip" >&2
	echo "  Debian: apt install cargo clang libgtk-4-dev libadwaita-1-dev libwebkitgtk-6.0-dev \\" >&2
	echo "          libgstreamer-plugins-base1.0-dev libsoup-3.0-dev libsqlite3-dev gstreamer1.0-libav 7zip" >&2
	exit 1
}

(cd "$root" && cargo build --locked --release)
mkdir -p "$bin" "$data/applications" "$data/icons/hicolor/512x512/apps"
# A copy, so that a later build in the checkout does not replace the binary of a running Amp. The
# binary keeps its own stderr in ~/.cache/amp-native/stderr.log when started from the desktop.
install -m755 "$root/target/release/amp-linux-desktop" "$bin/amp-linux-desktop.new"
mv -f "$bin/amp-linux-desktop.new" "$bin/amp-linux-desktop"

sed "s|@BIN@|$bin/amp-linux-desktop|g" "$root/data/dev.ampnative.Amp.desktop" >"$data/applications/dev.ampnative.Amp.desktop"

# Earlier versions put the LiveKit Python SDK here for Huddles; the binary includes LiveKit now.
rm -rf "$data/amp-native/python"

"$bin/amp-linux-desktop" --extract-icons || echo "install: continuing without Amp's icons" >&2
icon=$data/amp-native/icons/dark.png
[ -f "$icon" ] && cp "$icon" "$data/icons/hicolor/512x512/apps/dev.ampnative.Amp.png"

command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t "$data/icons/hicolor" || true
xdg-mime default dev.ampnative.Amp.desktop x-scheme-handler/com.ampcode.amp.linux.auth 2>/dev/null || true
echo "install: done. Open Amp from your launcher or run amp-linux-desktop."

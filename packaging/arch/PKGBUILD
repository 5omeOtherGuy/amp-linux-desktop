# Maintainer: Simon Gies <simon dot gies at pm dot me>

pkgname=amp-linux-desktop
pkgver=0.1.1
pkgrel=1
# Amp's macOS disk image, which the app icons are extracted from at build time. They are Amp's
# artwork, so the repository does not carry them. Any build listed in
# https://static.ampcode.com/mac/appcast.xml works.
_ampbuild=1125
# The prebuilt libwebrtc that Huddles link, as LiveKit's webrtc-sys build script would download
# it: WEBRTC_TAG in the webrtc-sys-build version that Cargo.lock pins.
_webrtc=webrtc-a545de4
pkgdesc='Native GTK 4 desktop app for Amp, the coding agent at ampcode.com'
arch=('x86_64')
url='https://github.com/5omeOtherGuy/amp-linux-desktop'
license=('MIT')
depends=('glib2' 'gtk4' 'libadwaita' 'pango' 'webkitgtk-6.0' 'libsoup3' 'gstreamer' 'gst-plugins-base-libs'
	'sqlite' 'glibc' 'hicolor-icon-theme')
makedepends=('git' 'cargo' 'clang' '7zip')
optdepends=(
	'gst-plugins-base: dictation'
	'gst-plugins-good: dictation and the Huddle camera'
	'gst-libav: video in the Desktop and Mac tabs of an orb thread'
	'ampcode: the Amp CLI for running threads on this computer (Amp installs it otherwise)'
)
# With makepkg's LTO flags the C parts of the dependencies (ring) compile to LTO objects that
# rust-lld cannot link: the build fails with undefined ring_core symbols.
options=('!lto')
source=("git+$url.git#tag=v$pkgver"
	"Amp-1.0-$_ampbuild.dmg::https://static.ampcode.com/mac/Amp-1.0-$_ampbuild.dmg"
	"$_webrtc-linux-x64-release.zip::https://github.com/livekit/rust-sdks/releases/download/$_webrtc/webrtc-linux-x64-release.zip")
noextract=("Amp-1.0-$_ampbuild.dmg")
sha256sums=('SKIP'
	'2a671b2a01cb356f79cc76ba5de6822c9df0182bacea3a302c6566c6f8d16f1f'
	'2ece73b9a72a2cacd73d0c62ac3a414e202f37885c3c8f49dddb43c1443ac0bd')

prepare() {
	cd "$pkgname"
	cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
	cd "$pkgname"
	export CARGO_TARGET_DIR=target LK_CUSTOM_WEBRTC="$srcdir/linux-x64-release"
	cargo build --frozen --release
	target/release/amp-linux-desktop --extract-icons --dmg "$srcdir/Amp-1.0-$_ampbuild.dmg" --out "$srcdir/icons"
}

package() {
	cd "$pkgname"
	install -Dm755 target/release/amp-linux-desktop "$pkgdir/usr/bin/amp-linux-desktop"
	# The desktop entry also receives the com.ampcode.amp.linux.auth sign-in callback.
	sed 's|@BIN@|/usr/bin/amp-linux-desktop|g' data/dev.ampnative.Amp.desktop |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dev.ampnative.Amp.desktop"

	install -Dm644 -t "$pkgdir/usr/share/amp-native/icons" "$srcdir"/icons/*.png
	install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
	install -Dm644 "$srcdir/icons/dark.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/dev.ampnative.Amp.png"
}

#!/bin/sh
# Builds amp-linux-desktop_VERSION-1_ARCH.deb from this checkout into OUTDIR. Runs on Debian or
# Ubuntu with cargo, clang 21 or later (CC and CXX pointing at it when the default clang is older),
# and the -dev packages the release workflow installs; CI runs it in a debian:trixie container.
#   packaging/debian/build-deb OUTDIR
# Amp's icons are not in the package: the app fetches them on first start (crates/common/src/icons.rs).
set -eu

root=$(cd "$(dirname "$0")/../.." && pwd)
out=$(mkdir -p "${1:?usage: build-deb OUTDIR}" && cd "$1" && pwd)
version=$(sed -n '/^\[workspace.package\]/,/^\[/ s/^version = "\(.*\)"$/\1/p' "$root/Cargo.toml")
arch=$(dpkg --print-architecture)
pkg=amp-linux-desktop
tree=$(mktemp -d)
trap 'rm -rf "$tree"' EXIT

(cd "$root" && cargo build --locked --release)
install -d "$tree/usr/bin" "$tree/usr/share/applications" "$tree/usr/share/doc/$pkg" "$tree/DEBIAN"
install -m755 -s "$root/target/release/amp-linux-desktop" "$tree/usr/bin/amp-linux-desktop"
# The desktop entry also receives the com.ampcode.amp.linux.auth sign-in callback.
sed 's|@BIN@|/usr/bin/amp-linux-desktop|g' "$root/data/dev.ampnative.Amp.desktop" >"$tree/usr/share/applications/dev.ampnative.Amp.desktop"
{
	echo "Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/"
	echo "Upstream-Name: $pkg"
	echo "Source: https://github.com/5omeOtherGuy/amp-linux-desktop"
	echo
	echo "Files: *"
	echo "Copyright: 2026 Simon Gies"
	echo "License: Expat"
	sed 's/^$/./; s/^/ /' "$root/LICENSE"
} >"$tree/usr/share/doc/$pkg/copyright"
chmod 644 "$tree/usr/share/doc/$pkg/copyright"

{
	echo "$pkg ($version-1) unstable; urgency=medium"
	echo
	echo "  * Package upstream release $version."
	echo
	echo " -- Simon Gies <simon.gies@pm.me>  $(date -Ru)"
} | gzip -9n >"$tree/usr/share/doc/$pkg/changelog.Debian.gz"

# dpkg-shlibdeps reads the libraries the binary links from the installed packages.
mkdir -p "$tree/debian"
echo "Source: $pkg" >"$tree/debian/control"
depends=$(cd "$tree" && dpkg-shlibdeps -O usr/bin/amp-linux-desktop | sed 's/^shlibs:Depends=//')
rm -r "$tree/debian"

cat >"$tree/DEBIAN/control" <<EOF
Package: $pkg
Version: $version-1
Architecture: $arch
Maintainer: Simon Gies <simon.gies@pm.me>
Installed-Size: $(du -sk "$tree/usr" | cut -f1)
Depends: $depends, 7zip | p7zip-full
Recommends: gstreamer1.0-libav, gstreamer1.0-plugins-base, gstreamer1.0-plugins-good, gstreamer1.0-pipewire
Section: devel
Priority: optional
Homepage: https://github.com/5omeOtherGuy/amp-linux-desktop
Description: Native GTK 4 desktop app for Amp, the coding agent at ampcode.com
 Runs ampcode.com in its own window like Amp's macOS app, with a menu bar,
 settings, a tray menu, notifications, desktop-wide actions, dictation, the
 local runner and Huddles. Amp's app icons are fetched from Amp's macOS disk
 image on first start.
EOF

dpkg-deb --root-owner-group --build "$tree" "$out/${pkg}_$version-1_$arch.deb" >/dev/null
echo "$out/${pkg}_$version-1_$arch.deb"
